---
extends: default

# Machine-written YAML takes its shape from a serializer, not from this style config. A
# style finding there would fail a PR over a file no human wrote. Each one has its own
# gate instead: `normalize --check` (layouts/), `split --check` (generated/),
# `gdcloud project --check` + gd-format-yaml (gd_data_product/).
ignore: |
  layouts/
  generated/
  gd_data_product/*/analytics_model/
  gd_data_product/*/ldm/
  tests/fixtures/
  backups/
  reports/
  graphify-out/
  .github/
  .venv/
  .git/

rules:
  # The repo's YAML is written by PyYAML / the SDK, which emit indentless sequences.
  indentation:
    spaces: consistent
    indent-sequences: whatever
  comments-indentation: disable
  document-start: disable
  commas:
    max-spaces-after: -1
  line-length:
    allow-non-breakable-inline-mappings: true
    allow-non-breakable-words: true
    max: 200
