            "tags": [
              "Assortment Efficiency"
            ],
            "title": "Product ID (Assortment Efficiency)"
          }
        ],
        "description": "Assortment Efficiency",
        "facts": [
          {
            "description": "Average inventory level recorded in the Assortment Efficiency dataset, used to analyze typical stock levels across products, locations, or time periods.",
            "id": "sql_assortment_efficiency.avg_inventory",
            "sourceColumn": "avg_inventory",
            "sourceColumnDataType": "INT",
            "tags": [
              "Assortment Efficiency"
            ],
            "title": "Avg Inventory"
          },
          {
            "description": "Sell-Through Rate is a measure in the Assortment Efficiency dataset that indicates how much of available inventory has been sold over a given period, helping assess product assortment performance.",
            "id": "sql_assortment_efficiency.sell_through_rate",
            "sourceColumn": "sell_through_rate",
            "sourceColumnDataType": "NUMERIC",
            "tags": [
              "Assortment Efficiency"
            ],
            "title": "Sell-Through Rate"
          },
          {
            "description": "Number of units sold captured in the Assortment Efficiency dataset, typically used to quantify sales volume across products, stores, or time periods.",
            "id": "sql_assortment_efficiency.units_sold",
            "sourceColumn": "units_sold",
            "sourceColumnDataType": "INT",
            "tags": [
              "Assortment Efficiency"
            ],
            "title": "Units Sold (Assortment Efficiency)"
          }
        ],
        "grain": [
          {
            "id": "sql_assortment_efficiency.product_id",
            "type": "attribute"
          }
        ],
        "id": "sql_assortment_efficiency",
        "references": [],
        "sql": {
          "dataSourceId": "globalmart-motherduck",
          "statement": "\nSELECT\n    p.product_id,\n    p.category_id,\n    SUM(ol.quantity) AS units_sold,\n    SUM(inv.on_hand_units) AS avg_inventory,\n    SUM(ol.quantity) / NULLIF(SUM(inv.on_hand_units), 0) AS sell_through_rate\nFROM globalmart.dim_product p\nLEFT JOIN globalmart.fact_order_line ol ON p.product_id = ol.product_id\nLEFT JOIN globalmart.fact_inventory_snapshot_daily inv ON p.product_id = inv.product_id\nGROUP BY 1, 2\n"
        },
        "tags": [
          "Assortment Efficiency"
        ],
        "title": "Assortment Efficiency"
      },
