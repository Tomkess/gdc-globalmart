        "attributes": [
          {
            "description": "Unique identifier for a product in the Assortment Efficiency dataset. Use it to group, filter, or drill into metrics at the individual product level.",
            "id": "sql_assortment_efficiency.product_id",
            "labels": [],
            "sourceColumn": "product_id",
