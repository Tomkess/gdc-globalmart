# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# One token per target, so several hosts coexist without editing anything between
# runs. The variable name is derived from the profile name in config/targets.yaml:
#
#   profile "demo-cloud"      ->  GLOBALMART_TOKEN__DEMO_CLOUD
#   profile "local-inference" ->  GLOBALMART_TOKEN__LOCAL_INFERENCE
#   profile "fresh-org"       ->  GLOBALMART_TOKEN__FRESH_ORG
#
# Rule: uppercase the profile name and replace "-" with "_".
#
# Everything non-secret (host, org id, datasource id, schema) lives in
# config/targets.yaml, in the open. Only secrets belong here.

# --- Targets ---------------------------------------------------------------

# petertomko.demo.cloud — the org GlobalMart is captured from today.
GLOBALMART_TOKEN__DEMO_CLOUD=

# Second demo org, used to prove cross-org portability.
# GLOBALMART_TOKEN__USECASES_AI=

# Same host as demo-cloud, but the load target: its own warehouse schema, and the only
# profile with data_owned: true. `globalmart data load` truncates, so it refuses every
# other profile (ADR 004).
# GLOBALMART_TOKEN__DEMO_CLOUD_REBUILD=

# Local-inference host. Uncomment the matching profile in config/targets.yaml.
# GLOBALMART_TOKEN__LOCAL_INFERENCE=

# Any empty org, for proving the cold rebuild.
# GLOBALMART_TOKEN__FRESH_ORG=

# --- Fallback --------------------------------------------------------------

# Used for any profile with no specific token above. Convenient for a one-off run
# against a single host; prefer the per-target variables when you have more than one,
# otherwise a mistyped --target silently reuses the wrong org's credentials.
# GLOBALMART_TOKEN=

# --- Warehouse secrets (FEAT-005) ------------------------------------------

# Referenced by name from a target profile's datasource_secret_env, never inline.
# Needed by `globalmart data load` and by publishing (the datasource is registered with
# these credentials). `globalmart data verify` needs neither — the data is committed.
# MOTHERDUCK_TOKEN=
# GLOBALMART_PG_PASSWORD=
