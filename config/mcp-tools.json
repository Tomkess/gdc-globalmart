                          "granularity": {
                            "description": "Granularity of a relative date filter, which counts whole periods back from the current period. For a recurring bucket, keep the date filter and add an attribute_filter on a periodical label such as label/order_date.dayOfWeek.",
                            "enum": [
                              "SECOND",
