                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null
                          },
                          "top": {
                            "type": "integer"
                          },
                          "type": {
                            "const": "ranking_filter",
                            "type": "string"
                          },
                          "using": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "using",
                          "top"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "attribute": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null
                          },
                          "bottom": {
                            "type": "integer"
                          },
                          "type": {
                            "const": "ranking_filter",
                            "type": "string"
                          },
                          "using": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "using",
                          "bottom"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "condition": {
                            "enum": [
                              "GREATER_THAN",
                              "GREATER_THAN_OR_EQUAL_TO",
                              "LESS_THAN",
                              "LESS_THAN_OR_EQUAL_TO",
